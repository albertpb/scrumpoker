# Server
ADDR=:8080

# Database adapter: sqlite or postgres
DATABASE_DRIVER=sqlite

# SQLite configuration
DATABASE_PATH=poker.db

# PostgreSQL/Supabase configuration. Required when DATABASE_DRIVER=postgres.
# Prefer the Supabase Session pooler URI and keep sslmode=require enabled.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# Optional: serve the built React application from the Go server.
# This path is relative to the backend process working directory.
# FRONTEND_DIR=../frontend/dist
